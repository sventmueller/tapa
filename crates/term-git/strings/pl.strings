/* Polish interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Anulowano.";
"Das Repository hat keine Arbeitskopie." = "Repozytorium nie ma kopii roboczej.";
"Der Branch hat keinen Upstream." = "Gałąź nie ma gałęzi nadrzędnej (upstream).";
"Der Hook „{}“ hat abgelehnt." = "Hook „{}” odmówił.";
"Der Ordner ist kein Git-Repository." = "Ten folder nie jest repozytorium Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Repozytorium zdalne odrzuciło push. Najpierw pobierz jego nowe commity (pull).";
"Der Remote ist nicht erreichbar." = "Repozytorium zdalne jest nieosiągalne.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash zmienił się w międzyczasie. Przejrzyj listę jeszcze raz i spróbuj ponownie.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Logowanie do repozytorium zdalnego nie powiodło się.";
"Die Commit-Nachricht fehlt." = "Brak wiadomości commitu.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Plik w międzyczasie się zmienił; fragment już nie pasuje.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Jeden konflikt. Rozwiąż go w edytorze, a potem oznacz plik jako rozwiązany.";
"Eine Binärdatei hat keine Abschnitte." = "Plik binarny nie ma fragmentów.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Nie można odczytać lub zapisać pliku.";
"Git hat mehr ausgegeben, als die App liest." = "Git wypisał więcej, niż odczytuje aplikacja.";
"Git hat zu lange gebraucht und wurde beendet." = "Git działał zbyt długo i został zatrzymany.";
"Git ist fehlgeschlagen." = "Git zakończył się błędem.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git nie jest zainstalowany. Zawierają go Command Line Tools: „xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git odrzuca repozytorium, ponieważ należy ono do innego użytkownika (safe.directory).";
