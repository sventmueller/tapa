/* Slovenian interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Preklicano.";
"Das Repository hat keine Arbeitskopie." = "Repozitorij nima delovne kopije.";
"Der Branch hat keinen Upstream." = "Veja nima nastavljenega upstreama.";
"Der Hook „{}“ hat abgelehnt." = "Hook »{}« je zavrnil izvedbo.";
"Der Ordner ist kein Git-Repository." = "Mapa ni repozitorij Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Oddaljeni repozitorij je zavrnil push. Najprej prenesite njegove nove commite (pull).";
"Der Remote ist nicht erreichbar." = "Oddaljeni repozitorij ni dosegljiv.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash se je medtem spremenil. Še enkrat preglejte seznam in poskusite znova.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Vpis v oddaljeni repozitorij ni uspel.";
"Die Commit-Nachricht fehlt." = "Manjka sporočilo commita.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Datoteka se je medtem spremenila; odsek se ne ujema več.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "En konflikt. Razrešite ga v urejevalniku in nato datoteko označite kot razrešeno.";
"Eine Binärdatei hat keine Abschnitte." = "Binarna datoteka nima odsekov.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Datoteke ni bilo mogoče prebrati ali zapisati.";
"Git hat mehr ausgegeben, als die App liest." = "Git je izpisal več, kot aplikacija prebere.";
"Git hat zu lange gebraucht und wurde beendet." = "Git je potreboval preveč časa in je bil ustavljen.";
"Git ist fehlgeschlagen." = "Ukaz Git ni uspel.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git ni nameščen. Vsebujejo ga orodja Command Line Tools: »xcode-select --install«.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git zavrača repozitorij, ker je last drugega uporabnika (safe.directory).";
