/* Norwegian Bokmål interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Avbrutt.";
"Das Repository hat keine Arbeitskopie." = "Repositoryet har ingen arbeidskopi.";
"Der Branch hat keinen Upstream." = "Branchen har ingen upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hooken «{}» avslo.";
"Der Ordner ist kein Git-Repository." = "Mappen er ikke et Git-repository.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Remoten avslo pushen. Hent de nye commitene først (pull).";
"Der Remote ist nicht erreichbar." = "Remoten kan ikke nås.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stashen har endret seg i mellomtiden. Se gjennom listen igjen og prøv på nytt.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Pålogging til remoten mislyktes.";
"Die Commit-Nachricht fehlt." = "Commit-meldingen mangler.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Filen har endret seg i mellomtiden; blokken passer ikke lenger.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Én konflikt. Løs den i editoren, og merk deretter filen som løst.";
"Eine Binärdatei hat keine Abschnitte." = "En binærfil har ingen blokker.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "En fil kunne ikke leses eller skrives.";
"Git hat mehr ausgegeben, als die App liest." = "Git skrev ut mer enn appen leser.";
"Git hat zu lange gebraucht und wurde beendet." = "Git brukte for lang tid og ble stoppet.";
"Git ist fehlgeschlagen." = "Git mislyktes.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git er ikke installert. Command Line Tools inneholder det: «xcode-select --install».";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git avviser repositoryet fordi det eies av en annen bruker (safe.directory).";
"Graph" = "Graf";
