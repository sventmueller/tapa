/* Catalan interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Cancel·lat.";
"Das Repository hat keine Arbeitskopie." = "El repositori no té cap còpia de treball.";
"Der Branch hat keinen Upstream." = "La branca no té cap upstream.";
"Der Hook „{}“ hat abgelehnt." = "El hook “{}” ho ha rebutjat.";
"Der Ordner ist kein Git-Repository." = "La carpeta no és un repositori de Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "El remot ha rebutjat el push. Primer fes pull dels seus commits nous.";
"Der Remote ist nicht erreichbar." = "No es pot accedir al remot.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "L’stash ha canviat mentrestant. Revisa la llista de nou i torna‑ho a provar.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "No s’ha pogut iniciar la sessió al remot.";
"Die Commit-Nachricht fehlt." = "Falta el missatge del commit.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Mentrestant, el fitxer ha canviat; el fragment ja no hi encaixa.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Un conflicte. Resol‑lo a l’editor i després marca el fitxer com a resolt.";
"Eine Binärdatei hat keine Abschnitte." = "Un fitxer binari no té fragments.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "No s’ha pogut llegir o escriure un fitxer.";
"Git hat mehr ausgegeben, als die App liest." = "Git ha generat més sortida de la que llegeix l’app.";
"Git hat zu lange gebraucht und wurde beendet." = "Git ha trigat massa i s’ha aturat.";
"Git ist fehlgeschlagen." = "Git ha fallat.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git no està instal·lat. Les Command Line Tools l’inclouen: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git rebutja el repositori perquè pertany a un altre usuari (safe.directory).";
"Graph" = "Graf";
"Konflikt" = "conflicte";
"Konflikte" = "Conflictes";
"Konflikte in {} Dateien. Löse sie im Editor und markiere die Dateien dann als gelöst." = "Conflictes en {} fitxers. Resol‑los a l’editor i després marca els fitxers com a resolts.";
"Lokale Änderungen würden überschrieben. Committe oder verwirf sie zuerst." = "Se sobreescriurien canvis locals. Primer fes‑ne commit o descarta’ls.";
"Lokaler und entfernter Branch sind auseinandergelaufen; ein Fast-Forward geht nicht." = "La branca local i la remota han divergit; no es pot fer un fast-forward.";
"Nicht versionierte Dateien kommen in den Papierkorb." = "Els fitxers sense seguiment es traslladaran a la paperera.";
"Nichts vorgemerkt." = "No hi ha res preparat.";
