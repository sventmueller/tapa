/* Czech interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Zrušeno.";
"Das Repository hat keine Arbeitskopie." = "Repozitář nemá pracovní kopii.";
"Der Branch hat keinen Upstream." = "Větev nemá upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hook „{}“ operaci odmítl.";
"Der Ordner ist kein Git-Repository." = "Složka není repozitář Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Vzdálený repozitář push odmítl. Nejprve stáhněte jeho nové commity (pull).";
"Der Remote ist nicht erreichbar." = "Vzdálený repozitář není dostupný.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash se mezitím změnil. Projděte seznam znovu a zkuste to ještě jednou.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Přihlášení ke vzdálenému repozitáři se nezdařilo.";
"Die Commit-Nachricht fehlt." = "Chybí zpráva commitu.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Soubor se mezitím změnil; blok už nesedí.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Jeden konflikt. Vyřešte ho v editoru a pak soubor označte jako vyřešený.";
"Eine Binärdatei hat keine Abschnitte." = "Binární soubor nemá bloky.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Soubor se nepodařilo přečíst nebo zapsat.";
"Git hat mehr ausgegeben, als die App liest." = "Git vypsal víc, než aplikace načte.";
"Git hat zu lange gebraucht und wurde beendet." = "Git trval příliš dlouho a byl ukončen.";
"Git ist fehlgeschlagen." = "Git selhal.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git není nainstalován. Obsahují ho nástroje Command Line Tools: „xcode-select --install“.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git repozitář odmítá, protože patří jinému uživateli (safe.directory).";
