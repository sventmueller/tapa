/* Finnish interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Peruttu.";
"Das Repository hat keine Arbeitskopie." = "Repositoriolla ei ole työkopiota.";
"Der Branch hat keinen Upstream." = "Haaralla ei ole upstream-haaraa.";
"Der Hook „{}“ hat abgelehnt." = "Hook ”{}” hylkäsi toiminnon.";
"Der Ordner ist kein Git-Repository." = "Kansio ei ole Git-repositorio.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Etärepositorio hylkäsi pushin. Hae ensin sen uudet commitit (Pull).";
"Der Remote ist nicht erreichbar." = "Etärepositorioon ei saada yhteyttä.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash on muuttunut sillä välin. Käy luettelo uudelleen läpi ja yritä uudelleen.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Kirjautuminen etärepositorioon epäonnistui.";
"Die Commit-Nachricht fehlt." = "Commit-viesti puuttuu.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Tiedosto on sillä välin muuttunut; lohko ei enää sovi.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Yksi ristiriita. Ratkaise se editorissa ja merkitse tiedosto sitten ratkaistuksi.";
"Eine Binärdatei hat keine Abschnitte." = "Binääritiedostossa ei ole lohkoja.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Tiedostoa ei voitu lukea tai kirjoittaa.";
"Git hat mehr ausgegeben, als die App liest." = "Git tulosti enemmän kuin appi lukee.";
"Git hat zu lange gebraucht und wurde beendet." = "Git kesti liian kauan, ja se pysäytettiin.";
"Git ist fehlgeschlagen." = "Git epäonnistui.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git ei ole asennettuna. Command Line Tools sisältää sen: ”xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git hylkää repositorion, koska sen omistaa toinen käyttäjä (safe.directory).";
"Graph" = "Graafi";
