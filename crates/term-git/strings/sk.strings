/* Slovak interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Zrušené.";
"Das Repository hat keine Arbeitskopie." = "Repozitár nemá pracovnú kópiu.";
"Der Branch hat keinen Upstream." = "Vetva nemá upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hook „{}“ odmietol pokračovať.";
"Der Ordner ist kein Git-Repository." = "Priečinok nie je repozitár Gitu.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Vzdialený repozitár odmietol push. Najprv stiahnite jeho nové commity (pull).";
"Der Remote ist nicht erreichbar." = "Vzdialený repozitár je nedostupný.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash sa medzitým zmenil. Prezrite si zoznam znova a skúste to ešte raz.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Prihlásenie do vzdialeného repozitára zlyhalo.";
"Die Commit-Nachricht fehlt." = "Chýba správa commitu.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Súbor sa medzitým zmenil; úsek už nesedí.";
