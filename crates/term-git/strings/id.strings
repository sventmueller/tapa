/* Indonesian interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Dibatalkan.";
"Das Repository hat keine Arbeitskopie." = "Repositori tidak memiliki salinan kerja.";
"Der Branch hat keinen Upstream." = "Branch tidak memiliki upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hook “{}” menolak.";
"Der Ordner ist kein Git-Repository." = "Folder ini bukan repositori Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Remote menolak push. Lakukan pull untuk commit barunya terlebih dahulu.";
"Der Remote ist nicht erreichbar." = "Remote tidak dapat dijangkau.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash telah berubah sementara itu. Periksa kembali daftarnya dan coba lagi.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Gagal masuk ke remote.";
"Die Commit-Nachricht fehlt." = "Pesan commit tidak ada.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "File telah berubah sementara itu; hunk tidak lagi cocok.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Satu konflik. Selesaikan di editor, lalu tandai file sebagai diselesaikan.";
"Eine Binärdatei hat keine Abschnitte." = "File biner tidak memiliki hunk.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Sebuah file tidak dapat dibaca atau ditulis.";
"Git hat mehr ausgegeben, als die App liest." = "Git menghasilkan output lebih banyak daripada yang dibaca aplikasi.";
"Git hat zu lange gebraucht und wurde beendet." = "Git terlalu lama dan dihentikan.";
"Git ist fehlgeschlagen." = "Git gagal.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git tidak terinstal. Command Line Tools menyertakannya: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git menolak repositori karena dimiliki pengguna lain (safe.directory).";
