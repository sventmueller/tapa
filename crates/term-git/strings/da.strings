/* Danish interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Annulleret.";
"Das Repository hat keine Arbeitskopie." = "Repositoryet har ingen arbejdskopi.";
"Der Branch hat keinen Upstream." = "Branchen har ingen upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hooken “{}” afviste.";
"Der Ordner ist kein Git-Repository." = "Mappen er ikke et Git-repository.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Remoten afviste pushet. Hent først dens nye commits (pull).";
"Der Remote ist nicht erreichbar." = "Remoten kan ikke nås.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stashen er ændret i mellemtiden. Gennemse listen igen, og prøv en gang til.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Login på remoten mislykkedes.";
"Die Commit-Nachricht fehlt." = "Commit-beskeden mangler.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Arkivet er ændret i mellemtiden; blokken passer ikke længere.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Én konflikt. Løs den i editoren, og marker derefter arkivet som løst.";
"Eine Binärdatei hat keine Abschnitte." = "Et binært arkiv har ingen blokke.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Et arkiv kunne ikke læses eller skrives.";
"Git hat mehr ausgegeben, als die App liest." = "Git udskrev mere, end appen læser.";
"Git hat zu lange gebraucht und wurde beendet." = "Git var for længe om det og blev stoppet.";
"Git ist fehlgeschlagen." = "Git mislykkedes.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git er ikke installeret. Command Line Tools indeholder det: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git afviser repositoryet, fordi det ejes af en anden bruger (safe.directory).";
