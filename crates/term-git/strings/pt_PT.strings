/* European Portuguese interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Cancelado.";
"Das Repository hat keine Arbeitskopie." = "O repositório não tem uma cópia de trabalho.";
"Der Branch hat keinen Upstream." = "O branch não tem upstream.";
"Der Hook „{}“ hat abgelehnt." = "O hook “{}” recusou.";
"Der Ordner ist kein Git-Repository." = "A pasta não é um repositório Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "O remoto recusou o push. Obtenha primeiro os novos commits (pull).";
"Der Remote ist nicht erreichbar." = "Não é possível aceder ao remoto.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "O stash foi alterado entretanto. Reveja a lista e tente novamente.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Falha ao iniciar sessão no remoto.";
"Die Commit-Nachricht fehlt." = "Falta a mensagem do commit.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "O ficheiro mudou entretanto; o bloco já não corresponde.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Um conflito. Resolva-o no editor e assinale depois o ficheiro como resolvido.";
"Eine Binärdatei hat keine Abschnitte." = "Um ficheiro binário não tem blocos.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Não foi possível ler ou escrever um ficheiro.";
"Git hat mehr ausgegeben, als die App liest." = "O Git produziu mais saída do que a aplicação lê.";
"Git hat zu lange gebraucht und wurde beendet." = "O Git demorou demasiado e foi parado.";
"Git ist fehlgeschlagen." = "O Git falhou.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "O Git não está instalado. As Command Line Tools incluem-no: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "O Git recusa o repositório porque pertence a outro utilizador (safe.directory).";
