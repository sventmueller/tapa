/* Ukrainian interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Скасовано.";
"Das Repository hat keine Arbeitskopie." = "Репозиторій не має робочої копії.";
"Der Branch hat keinen Upstream." = "Гілка не має upstream.";
"Der Hook „{}“ hat abgelehnt." = "Хук «{}» відхилив операцію.";
"Der Ordner ist kein Git-Repository." = "Папка не є репозиторієм Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Віддалений репозиторій відхилив push. Спершу отримайте його нові коміти (pull).";
"Der Remote ist nicht erreichbar." = "Віддалений репозиторій недоступний.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash тим часом змінився. Перегляньте список ще раз і спробуйте знову.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Не вдалося увійти у віддалений репозиторій.";
"Die Commit-Nachricht fehlt." = "Немає повідомлення коміту.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Тим часом файл змінився; фрагмент більше не підходить.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Один конфлікт. Розвʼяжіть його в редакторі, а потім позначте файл як розвʼязаний.";
"Eine Binärdatei hat keine Abschnitte." = "Двійковий файл не має фрагментів.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Не вдалося прочитати або записати файл.";
"Git hat mehr ausgegeben, als die App liest." = "Git вивів більше, ніж читає програма.";
"Git hat zu lange gebraucht und wurde beendet." = "Git працював надто довго, і його було зупинено.";
"Git ist fehlgeschlagen." = "Помилка Git.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git не інстальовано. Він входить до Command Line Tools: «xcode-select --install».";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git відхиляє репозиторій, бо той належить іншому користувачеві (safe.directory).";
"Graph" = "Граф";
"Konflikt" = "конфлікт";
"Konflikte" = "Конфлікти";
"Konflikte in {} Dateien. Löse sie im Editor und markiere die Dateien dann als gelöst." = "Файлів із конфліктами: {}. Розвʼяжіть конфлікти в редакторі, а потім позначте файли як розвʼязані.";
"Lokale Änderungen würden überschrieben. Committe oder verwirf sie zuerst." = "Локальні зміни буде перезаписано. Спершу закомітьте або відкиньте їх.";
"Lokaler und entfernter Branch sind auseinandergelaufen; ein Fast-Forward geht nicht." = "Локальна й віддалена гілки розійшлися; fast-forward неможливий.";
"Nicht versionierte Dateien kommen in den Papierkorb." = "Невідстежувані файли буде переміщено в Смітник.";
"Nichts vorgemerkt." = "Нічого не проіндексовано.";
