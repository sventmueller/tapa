/* Malay interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Dibatalkan.";
"Das Repository hat keine Arbeitskopie." = "Repositori tidak mempunyai salinan kerja.";
"Der Branch hat keinen Upstream." = "Branch tidak mempunyai upstream.";
"Der Hook „{}“ hat abgelehnt." = "Hook “{}” menolak.";
"Der Ordner ist kein Git-Repository." = "Folder ini bukan repositori Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "Remote menolak push. Buat pull untuk commit baharunya dahulu.";
"Der Remote ist nicht erreichbar." = "Remote tidak dapat dicapai.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "Stash telah berubah sementara itu. Semak senarai sekali lagi dan cuba semula.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Gagal mendaftar masuk ke remote.";
"Die Commit-Nachricht fehlt." = "Mesej commit tiada.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "Fail telah berubah sementara itu; hunk tidak lagi sepadan.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Satu konflik. Selesaikannya dalam editor, kemudian tandakan fail sebagai diselesaikan.";
"Eine Binärdatei hat keine Abschnitte." = "Fail binari tidak mempunyai hunk.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Fail tidak dapat dibaca atau ditulis.";
"Git hat mehr ausgegeben, als die App liest." = "Git mengeluarkan lebih banyak output daripada yang dibaca oleh app.";
"Git hat zu lange gebraucht und wurde beendet." = "Git mengambil masa terlalu lama dan telah dihentikan.";
"Git ist fehlgeschlagen." = "Git gagal.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "Git tidak dipasang. Command Line Tools menyertakannya: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "Git menolak repositori kerana ia dimiliki oleh pengguna lain (safe.directory).";
