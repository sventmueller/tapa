/* Brazilian Portuguese interface texts; the keys are the German texts in the code. */
"Abgebrochen." = "Cancelado.";
"Das Repository hat keine Arbeitskopie." = "O repositório não tem uma cópia de trabalho.";
"Der Branch hat keinen Upstream." = "A branch não tem upstream.";
"Der Hook „{}“ hat abgelehnt." = "O hook “{}” recusou.";
"Der Ordner ist kein Git-Repository." = "A pasta não é um repositório Git.";
"Der Remote hat den Push abgelehnt. Hol zuerst seine neuen Commits (Pull)." = "O remoto recusou o push. Faça pull dos novos commits dele primeiro.";
"Der Remote ist nicht erreichbar." = "O remoto não pode ser alcançado.";
"Der Stash hat sich inzwischen geändert. Sieh die Liste noch einmal durch und versuch es erneut." = "O stash mudou nesse meio-tempo. Revise a lista e tente novamente.";
"Die Anmeldung beim Remote ist fehlgeschlagen." = "Falha ao iniciar sessão no remoto.";
"Die Commit-Nachricht fehlt." = "Falta a mensagem do commit.";
"Die Datei hat sich inzwischen geändert; der Abschnitt passt nicht mehr." = "O arquivo mudou nesse meio-tempo; o bloco não se encaixa mais.";
"Ein Konflikt. Löse ihn im Editor und markiere die Datei dann als gelöst." = "Um conflito. Resolva-o no editor e marque o arquivo como resolvido.";
"Eine Binärdatei hat keine Abschnitte." = "Um arquivo binário não tem blocos.";
"Eine Datei ließ sich nicht lesen oder schreiben." = "Não foi possível ler ou gravar um arquivo.";
"Git hat mehr ausgegeben, als die App liest." = "O Git gerou mais saída do que o app lê.";
"Git hat zu lange gebraucht und wurde beendet." = "O Git demorou demais e foi interrompido.";
"Git ist fehlgeschlagen." = "O Git falhou.";
"Git ist nicht installiert. Die Command Line Tools bringen es mit: „xcode-select --install“." = "O Git não está instalado. As Command Line Tools o incluem: “xcode-select --install”.";
"Git lehnt das Repository ab, weil es einem anderen Benutzer gehört (safe.directory)." = "O Git recusa o repositório porque ele pertence a outro usuário (safe.directory).";
